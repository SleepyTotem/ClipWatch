<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <Color x:Key="Ink0C">#0D0C0B</Color>
    <Color x:Key="Ink1C">#141311</Color>
    <Color x:Key="Ink2C">#1B1917</Color>
    <Color x:Key="Ink3C">#232120</Color>
    <Color x:Key="LineC">#2E2A27</Color>
    <Color x:Key="LineSoftC">#211E1C</Color>
    <Color x:Key="TextC">#F5F2ED</Color>
    <Color x:Key="MutedC">#A69F95</Color>
    <Color x:Key="FaintC">#6B655E</Color>
    <Color x:Key="AccentC">#FF8A3D</Color>
    <Color x:Key="AccentHotC">#FFA463</Color>
    <Color x:Key="AccentDeepC">#3A2216</Color>
    <Color x:Key="LiveC">#56D68A</Color>
    <Color x:Key="WarnC">#E7B84E</Color>
    <Color x:Key="DangerC">#F0555B</Color>

    <SolidColorBrush x:Key="Ink0"       Color="{StaticResource Ink0C}"/>
    <SolidColorBrush x:Key="Ink1"       Color="{StaticResource Ink1C}"/>
    <SolidColorBrush x:Key="Ink2"       Color="{StaticResource Ink2C}"/>
    <SolidColorBrush x:Key="Ink3"       Color="{StaticResource Ink3C}"/>
    <SolidColorBrush x:Key="Line"       Color="{StaticResource LineC}"/>
    <SolidColorBrush x:Key="LineSoft"   Color="{StaticResource LineSoftC}"/>
    <SolidColorBrush x:Key="Text"       Color="{StaticResource TextC}"/>
    <SolidColorBrush x:Key="Muted"      Color="{StaticResource MutedC}"/>
    <SolidColorBrush x:Key="Faint"      Color="{StaticResource FaintC}"/>
    <SolidColorBrush x:Key="Accent"     Color="{StaticResource AccentC}"/>
    <SolidColorBrush x:Key="AccentHot"  Color="{StaticResource AccentHotC}"/>
    <SolidColorBrush x:Key="AccentDeep" Color="{StaticResource AccentDeepC}"/>
    <SolidColorBrush x:Key="Live"       Color="{StaticResource LiveC}"/>
    <SolidColorBrush x:Key="Warn"       Color="{StaticResource WarnC}"/>
    <SolidColorBrush x:Key="Danger"     Color="{StaticResource DangerC}"/>

    <SolidColorBrush x:Key="Bg"        Color="{StaticResource Ink0C}"/>
    <SolidColorBrush x:Key="Panel"     Color="{StaticResource Ink1C}"/>
    <SolidColorBrush x:Key="Card"      Color="{StaticResource Ink2C}"/>
    <SolidColorBrush x:Key="CardHover" Color="{StaticResource Ink3C}"/>
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDeepC}"/>

    <SolidColorBrush x:Key="Sheen"      Color="#FFFFFF" Opacity="0.06"/>
    <SolidColorBrush x:Key="SheenStrong" Color="#FFFFFF" Opacity="0.10"/>
    <SolidColorBrush x:Key="Field"      Color="#100F0E"/>
    <SolidColorBrush x:Key="Scrim"      Color="#000000" Opacity="0.55"/>

    <SolidColorBrush x:Key="OnInk"      Color="#1A0E06"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="TitleBarHeight">30</sys:Double>

    <CubicEase x:Key="Out" EasingMode="EaseOut"/>
    <QuarticEase x:Key="OutHard" EasingMode="EaseOut"/>

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="Background" Value="{StaticResource Ink0}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="0"
                                    ResizeBorderThickness="6"
                                    CornerRadius="0"
                                    GlassFrameThickness="0"
                                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Hi" Background="{StaticResource SheenStrong}" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.10"
                                                     EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.16"
                                                     EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Hi" Opacity="0">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource DangerC}"/>
                            </Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.10"
                                                     EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.16"
                                                     EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Width" Value="11"/>
        <Setter Property="MinWidth" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb x:Name="T" Style="{StaticResource ScrollThumb}" Opacity="0.5">
                                    <Thumb.Background>
                                        <SolidColorBrush Color="{StaticResource MutedC}"/>
                                    </Thumb.Background>
                                </Thumb>
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                              Focusable="False" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                              Focusable="False" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12"
                                                     EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Opacity"
                                                     To="0.5" Duration="0:0:0.25"
                                                     EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter Property="Height" Value="11"/>
                            <Setter Property="MinHeight" Value="11"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="MinWidth" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="PanningMode" Value="VerticalOnly"/>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Ink2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"/>
                        <Border x:Name="Hi" Background="{StaticResource Sheen}"
                                CornerRadius="8" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>

                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12"
                                                     EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.18"
                                                     EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.14"
                                                     EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.14"
                                                     EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="Mouse.PreviewMouseDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="0.965" Duration="0:0:0.06"
                                                     EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="0.965" Duration="0:0:0.06"
                                                     EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.PreviewMouseUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.16"
                                                     EasingFunction="{StaticResource OutHard}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.16"
                                                     EasingFunction="{StaticResource OutHard}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentHot}"/>
        <Setter Property="Foreground" Value="#1A0E06"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
    </Style>

    <Style x:Key="IconControl" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Hi" Background="{StaticResource Sheen}"
                                CornerRadius="10" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32"/>
                        </Trigger>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12"
                                                     EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.18"
                                                     EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.14" EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.14" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.PreviewMouseDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="0.88" Duration="0:0:0.06" EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="0.88" Duration="0:0:0.06" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.PreviewMouseUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.18" EasingFunction="{StaticResource OutHard}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.18" EasingFunction="{StaticResource OutHard}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32"/>
                        </Trigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.14" EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.14" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.PreviewMouseDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="0.86" Duration="0:0:0.06" EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="0.86" Duration="0:0:0.06" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.PreviewMouseUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.18" EasingFunction="{StaticResource OutHard}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.18" EasingFunction="{StaticResource OutHard}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="8,1"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Height="40">
                        <Border x:Name="Bg" CornerRadius="9" Opacity="0">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource Ink3C}"/>
                            </Border.Background>
                        </Border>

                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource AccentC}"/>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BarSc" ScaleY="0"/>
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}"
                                       FontFamily="{StaticResource IconFont}" FontSize="15"
                                       FontWeight="Normal"
                                       Width="22" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}"/>

                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BarSc"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource OutHard}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BarSc"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.2" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RailStatus" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="RailStatusCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Field}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.3"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"/>

                        <Border x:Name="Ring" CornerRadius="8" BorderThickness="1" Opacity="0">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource AccentC}"/>
                            </Border.BorderBrush>
                        </Border>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <EventTrigger RoutedEvent="UIElement.GotKeyboardFocus">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.14" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.LostKeyboardFocus">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.18" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="36" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10"
                                    Background="{StaticResource Field}"
                                    BorderThickness="1">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{StaticResource LineC}"/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="TrackOn" CornerRadius="10" Opacity="0">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource AccentC}"/>
                                </Border.Background>
                            </Border>
                            <Ellipse x:Name="Knob" Width="14" Height="14"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="3,0,0,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{StaticResource FaintC}"/>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobMove" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource OnInk}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove"
                                                         Storyboard.TargetProperty="X"
                                                         To="16" Duration="0:0:0.20"
                                                         EasingFunction="{StaticResource OutHard}"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.20"
                                                         EasingFunction="{StaticResource OutHard}"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,14,0,5"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="Section" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Ink1}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="Rule" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="{StaticResource LineSoft}"/>
        <Setter Property="Margin" Value="0,14"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Hi" CornerRadius="7" Background="{StaticResource Sheen}" Opacity="0"/>
                        <Border x:Name="Sel" CornerRadius="7" BorderThickness="1" Opacity="0">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource AccentDeepC}"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource AccentC}" Opacity="0.55"/>
                            </Border.BorderBrush>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Sel" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentHot}"/>
                        </Trigger>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.10" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.16" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">

                    <Grid Margin="10,6,14,14">
                        <Border x:Name="Shell" CornerRadius="11"
                                Background="{StaticResource Ink1}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                Padding="5" RenderTransformOrigin="0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                                                  Opacity="0.5" Color="#000000"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Slide" Y="-6"/>
                            </Border.RenderTransform>
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>

                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.12"
                                                     EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y"
                                                     From="-6" To="0" Duration="0:0:0.18"
                                                     EasingFunction="{StaticResource OutHard}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Height="32">
                        <Border x:Name="Hi" CornerRadius="7" Opacity="0">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource Ink3C}"/>
                            </Border.Background>
                        </Border>
                        <Grid Margin="12,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Head" ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       VerticalAlignment="Center" Margin="24,0,0,0"
                                       FontSize="11.5" Foreground="{StaticResource Faint}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hi" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="12,5" Fill="{StaticResource Line}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Placement" Value="Bottom"/>
        <Setter Property="VerticalOffset" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="8,4,12,12">
                        <Border x:Name="Shell" CornerRadius="8"
                                Background="{StaticResource Ink3}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                Padding="10,6" RenderTransformOrigin="0.5,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                                  Opacity="0.45" Color="#000000"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Slide" Y="-4"/>
                            </Border.RenderTransform>
                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="12"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.12"
                                                     EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y"
                                                     From="-4" To="0" Duration="0:0:0.16"
                                                     EasingFunction="{StaticResource OutHard}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Ellipse Fill="{StaticResource Text}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="1.2" Duration="0:0:0.12" EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="1.2" Duration="0:0:0.12" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.16" EasingFunction="{StaticResource Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.16" EasingFunction="{StaticResource Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Field}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Margin="0,0,-2,0">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{StaticResource AccentC}"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Storyboard x:Key="RiseIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.22"
                         EasingFunction="{StaticResource Out}"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                         From="10" To="0" Duration="0:0:0.28"
                         EasingFunction="{StaticResource OutHard}"/>
    </Storyboard>

</ResourceDictionary>
