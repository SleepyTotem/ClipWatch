<UserControl x:Class="ClipWatch.ClipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipWatch">

    <UserControl.Resources>
        <local:ThumbnailConverter x:Key="Thumb"/>

        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Width="320">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Rise" Y="0"/>
                            </Grid.RenderTransform>

                            <Border x:Name="Bg" CornerRadius="14"
                                    Background="{StaticResource Ink1}"
                                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1"/>

                            <ContentPresenter/>

                            <Border x:Name="Ring" CornerRadius="14" BorderThickness="1"
                                    Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{StaticResource AccentC}"/>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>

                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource Out}"/>
                                        <DoubleAnimation Storyboard.TargetName="Rise"
                                                         Storyboard.TargetProperty="Y"
                                                         From="14" To="0" Duration="0:0:0.3"
                                                         EasingFunction="{StaticResource OutHard}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2"
                                                         EasingFunction="{StaticResource Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource Ink0}">

        <StackPanel DockPanel.Dock="Top" Margin="32,26,32,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Clips" Style="{StaticResource H1}" VerticalAlignment="Center"/>

                    <Border x:Name="CountChip" Background="{StaticResource Ink2}" CornerRadius="9"
                            Padding="9,3" Margin="12,4,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ClipCount" Text="0" FontSize="11.5"
                                   Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Grid Width="250" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" Padding="34,7,10,7"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                   FontSize="13" Foreground="{StaticResource Faint}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Search clips"
                                   Foreground="{StaticResource Faint}" FontSize="13"
                                   VerticalAlignment="Center" Margin="35,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <Button Content="&#xE838;" Style="{StaticResource IconControl}"
                            Click="OpenFolder_Click" ToolTip="Open the clips folder"
                            AutomationProperties.Name="Open clips folder"/>
                    <Button Content="&#xE72C;" Style="{StaticResource IconControl}"
                            Click="Refresh_Click" ToolTip="Rescan the folder"
                            AutomationProperties.Name="Refresh"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="FolderLabel" Foreground="{StaticResource Faint}" FontSize="11.5"
                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>

            <Border x:Name="FfmpegWarning" Background="{StaticResource Ink1}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                    CornerRadius="11" Margin="0,14,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Warn}"
                            CornerRadius="11,0,0,11"/>
                    <DockPanel Grid.Column="1" LastChildFill="True" Margin="16,12,14,12">
                        <Button x:Name="InstallFfmpegButton" DockPanel.Dock="Right"
                                Content="Install ffmpeg" Style="{StaticResource AccentButton}"
                                Click="InstallFfmpeg_Click" VerticalAlignment="Center"
                                Margin="16,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="ffmpeg isn't installed" FontWeight="SemiBold"
                                       Foreground="{StaticResource Warn}" FontSize="13"/>
                            <TextBlock Style="{StaticResource Sub}"
                                       Text="Thumbnails and trimming stay unavailable until it's here."/>
                            <TextBlock x:Name="FfmpegProgressText" Style="{StaticResource Hint}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,4,20,24">
                <ItemsControl x:Name="ClipItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Click="Card_Click" Tag="{Binding}"
                                    ToolTip="{Binding DisplayName}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit" Click="MenuEdit_Click"/>
                                        <MenuItem Header="Play in default player" Click="MenuPlay_Click"/>
                                        <MenuItem Header="Show in folder" Click="MenuReveal_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Rename..." Click="MenuRename_Click"/>
                                        <MenuItem Header="Delete" Click="MenuDelete_Click"
                                                  Style="{StaticResource DangerMenuItem}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>

                                <StackPanel>
                                    <Grid>
                                        <Border Background="#08090A" CornerRadius="13,13,0,0" Height="180"/>
                                        <Border CornerRadius="13,13,0,0" Height="180">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill"
                                                            ImageSource="{Binding ThumbnailPath, Converter={StaticResource Thumb}}"/>
                                            </Border.Background>
                                        </Border>
                                        <Border Background="#B3000000" CornerRadius="6" Padding="7,2"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,10,10">
                                            <TextBlock Text="{Binding DurationText}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Margin="15,12,15,14">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding CreatedText}" FontSize="11.5"
                                                       Foreground="{StaticResource Faint}"/>
                                            <TextBlock Text="  ·  " FontSize="11.5"
                                                       Foreground="{StaticResource Faint}"/>
                                            <TextBlock Text="{Binding SizeText}" FontSize="11.5"
                                                       Foreground="{StaticResource Faint}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyLabel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,0,0,60">
                <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}"
                           FontSize="42" Foreground="{StaticResource Ink3}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="No clips yet" Style="{StaticResource H2}"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="Save a replay in OBS and it'll appear here."
                           Foreground="{StaticResource Faint}" FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
